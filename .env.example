# Copia este ficheiro para .env e preenche os valores. O .env NUNCA vai para o Git.

# --- Base de dados MySQL ---
DB_NAME=njangoedu
DB_USER=njango_user
DB_PASSWORD=COLOCA_AQUI_A_TUA_PASSE
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Django (opcionais em desenvolvimento) ---
# Em produção: DJANGO_DEBUG=False e uma DJANGO_SECRET_KEY longa e secreta.
# DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Frontend React (endereços autorizados a chamar a API) ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Duração da sessão do aluno, em horas ---
# SESSAO_ALUNO_HORAS=24
